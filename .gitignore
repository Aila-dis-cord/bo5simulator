# 依存関係
node_modules/

# ビルド成果物（Vercelが自動ビルドするためコミット不要）
dist/
dist-ssr/

# ログファイル
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ローカル環境変数（機密情報を含む可能性あり）
*.local
.env
.env.*
!.env.example

# エディタ・OS固有ファイル
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# VS Code（プロジェクト共有設定のみコミット対象）
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains IDE
.idea/

# キャッシュ
.cache/
.parcel-cache/
